#!/bin/sh
# ReelStudio CLI launcher for the Codex plugin.
# `reelstudio setup` installs/updates the engine in ~/ReelStudio from the newest installed plugin version;
# every other command runs the engine in ~/ReelStudio.
HOME_RS="${REELSTUDIO_HOME:-$HOME/ReelStudio}"

# `reelstudio key`: type the OpenRouter key in YOUR terminal (hidden), saved to ~/ReelStudio/.env (chmod 600).
# The key never goes through a chat or an agent.
if [ "$1" = "key" ]; then
  if [ ! -t 0 ]; then
    echo "✗ Run this yourself in a Terminal window: reelstudio key   (it asks for the key without showing it)"; exit 1
  fi
  ENV="$HOME_RS/.env"
  mkdir -p "$HOME_RS"
  stty -echo; trap 'stty echo' EXIT INT TERM
  printf 'OpenRouter API key (https://openrouter.ai/keys), hidden while you paste: '
  IFS= read -r KEY; stty echo; printf '\n'
  KEY=$(printf '%s' "$KEY" | tr -d '[:space:]')
  case "$KEY" in sk-or-*) ;; *) echo "✗ That does not look like an OpenRouter key (it starts with sk-or-). Nothing saved."; exit 1;; esac
  touch "$ENV"; chmod 600 "$ENV"
  grep -v '^[[:space:]]*#\{0,1\}[[:space:]]*OPENROUTER_API_KEY=' "$ENV" > "$ENV.tmp" 2>/dev/null || true
  printf 'OPENROUTER_API_KEY=%s\n' "$KEY" >> "$ENV.tmp"
  mv "$ENV.tmp" "$ENV"; chmod 600 "$ENV"
  echo "✓ Key saved in $ENV (only your user can read it)"
  exit 0
fi

find_src() {
  found=$(ls -d "$HOME"/.codex/plugins/cache/reelstudio/reelstudio/*/engine 2>/dev/null | sort -V | tail -1)
  [ -n "$found" ] && { echo "$found"; return; }
  here=$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)   # running from a git checkout
  [ -f "$here/engine/bin/rs.mjs" ] && echo "$here/engine"
}

if [ "$1" = "setup" ] || [ ! -f "$HOME_RS/engine/bin/rs.mjs" ]; then
  SRC=$(find_src)
  [ -z "$SRC" ] && { echo "✗ ReelStudio Codex plugin not found: run install.sh first"; exit 1; }
  if [ "$1" = "setup" ]; then exec node "$SRC/bin/rs.mjs" "$@"; fi
  node "$SRC/bin/rs.mjs" setup || exit 1
fi
exec node "$HOME_RS/engine/bin/rs.mjs" "$@"
